# Copy to apps/web/.env.local to override defaults (optional).

# Base URL of the API. Default: same-origin "/api/v1" (Vite proxies /api to the API in development).
# VITE_API_BASE_URL=/api/v1

# Dev server proxy target (read by vite.config.ts, not exposed to the browser).
# VITE_DEV_API_TARGET=http://127.0.0.1:3000

# How long one API request may take before it is aborted, in milliseconds (1000-120000).
# VITE_API_TIMEOUT_MS=15000
