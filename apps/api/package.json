{
  "name": "@agentos/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch --exec \"node --env-file-if-exists=../../.env\"",
    "build": "nest build",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node ../../tools/check-module-boundaries.mjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status"
  },
  "nx": {
    "tags": [
      "type:app",
      "scope:backend"
    ],
    "targets": {
      "generate": {
        "cache": false
      },
      "build": {
        "dependsOn": [
          "^build",
          "generate"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "^build",
          "generate"
        ]
      },
      "test": {
        "dependsOn": [
          "^build",
          "generate"
        ]
      },
      "test:integration": {
        "dependsOn": [
          "^build",
          "generate"
        ],
        "cache": false
      }
    }
  },
  "dependencies": {
    "@agentos/config": "workspace:*",
    "@agentos/contracts": "workspace:*",
    "@agentos/logger": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "6.19.3",
    "ioredis": "5.10.1",
    "nestjs-pino": "^4.4.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@swc/core": "^1.12.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.0",
    "express": "5.2.1",
    "pino-pretty": "^13.0.0",
    "prisma": "6.19.3",
    "supertest": "^7.1.0",
    "typescript": "~5.8.3",
    "unplugin-swc": "^1.5.0",
    "vitest": "^3.2.0"
  }
}
