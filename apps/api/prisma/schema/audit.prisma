// Audit trail (ADR-0010, decision 6). Owned by apps/api/src/modules/audit. Append-only: the application role may only INSERT
// (see the privileges migration), and database triggers reject UPDATE, DELETE and TRUNCATE. There are deliberately NO foreign
// keys: a history must outlive, and never block, what it describes, and this keeps the audit module a leaf.

enum AuditResult {
  success
  failure

  @@schema("security")
}

model AuditLog {
  /// Generated by the application, so the writer needs no RETURNING (and therefore no SELECT privilege).
  id             String      @id @db.Uuid
  occurredAt     DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorUserId    String?     @map("actor_user_id") @db.Uuid
  organizationId String?     @map("organization_id") @db.Uuid
  projectId      String?     @map("project_id") @db.Uuid
  action         String
  resourceType   String      @map("resource_type")
  resourceId     String?     @map("resource_id") @db.Uuid
  result         AuditResult
  correlationId  String?     @map("correlation_id")
  /// Validated per action by the contracts (ids, counts and enum values only): never a secret.
  metadata       Json        @default("{}")

  // The key a future organization-scoped, keyset-paginated reader needs.
  @@index([organizationId, occurredAt, id])
  @@index([action])
  @@map("audit_log")
  @@schema("security")
}
