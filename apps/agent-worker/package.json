{
  "name": "@agentos/agent-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "node --env-file=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "nx": {
    "tags": [
      "type:app",
      "scope:backend"
    ]
  },
  "dependencies": {
    "@agentos/config": "workspace:*",
    "@agentos/contracts": "workspace:*",
    "@agentos/database": "workspace:*",
    "@agentos/logger": "workspace:*",
    "bullmq": "^5.56.0",
    "ioredis": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.0"
  }
}
