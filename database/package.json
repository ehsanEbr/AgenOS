{
  "name": "@agentos/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations and the shared database client.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "migrate:dev": "dotenv -e ../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../.env -- prisma migrate deploy",
    "migrate:status": "dotenv -e ../.env -- prisma migrate status"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "nx": {
    "tags": [
      "type:lib",
      "scope:backend"
    ]
  },
  "dependencies": {
    "@prisma/client": "^6.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.10.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0"
  }
}
