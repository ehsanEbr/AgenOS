// AgentOS database schema.
//
// Phase 1 only contains `SystemJob`, a foundation/smoke-test entity that proves the
// API -> queue -> worker -> PostgreSQL path. Domain entities (identity, projects,
// agents, models, ...) are added by their own phases, following docs/adr and the
// database design in the architecture spec (UUID keys, UTC timestamps, explicit
// organization/project scoping).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model SystemJob {
  id            String          @id @default(uuid()) @db.Uuid
  status        SystemJobStatus @default(QUEUED)
  message       String
  output        String?
  error         String?
  attempts      Int             @default(0)
  correlationId String          @map("correlation_id")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  startedAt     DateTime?       @map("started_at") @db.Timestamptz(3)
  completedAt   DateTime?       @map("completed_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("system_jobs")
}
