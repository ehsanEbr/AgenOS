{
  "name": "@agentos/logger",
  "version": "0.1.0",
  "private": true,
  "description": "Structured logging conventions (pino) shared by every backend process.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "nx": {
    "tags": [
      "type:lib",
      "scope:backend"
    ]
  },
  "dependencies": {
    "pino": "^9.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "vitest": "^3.2.0"
  }
}
