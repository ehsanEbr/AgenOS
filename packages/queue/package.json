{
  "name": "@agentos/queue",
  "version": "0.1.0",
  "private": true,
  "description": "Queue infrastructure: Redis connections, queue definitions with retry policy, and the job producer. The only shared code that talks to BullMQ.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "nx": {
    "tags": [
      "type:lib",
      "scope:backend"
    ]
  },
  "dependencies": {
    "@agentos/contracts": "workspace:*",
    "bullmq": "5.76.3",
    "ioredis": "5.10.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "vitest": "^3.2.0"
  }
}
