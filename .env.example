# Local development configuration. Do NOT put real or shared credentials in this file.
#
#   pnpm setup:env      creates .env from this file with freshly generated random passwords
#
# .env is git-ignored. Docker Compose, the API and the Prisma CLI all read it.

NODE_ENV=development
LOG_LEVEL=info

# --- API ---
API_HOST=127.0.0.1
API_PORT=3000
CORS_ORIGINS=http://localhost:5173
# Host port of the web app when the full stack runs in containers (`pnpm stack:up`). `pnpm dev` always uses Vite's own port.
WEB_PORT=5173

# --- Authentication (ADR-0010) ---
# The origin the browser uses to reach the web app (scheme://host[:port], no path). It sets the session cookie's Secure flag and is the
# only origin a cookie-authenticated state-changing request may come from (CSRF defense). Match the web app you actually use: Vite's
# `pnpm dev` is 5173, the containerized web app is WEB_PORT. Plain http is accepted only for localhost unless
# AUTH_ALLOW_INSECURE_ORIGIN=true.
WEB_ORIGIN=http://localhost:5173
# The first user of an empty instance can always register. After that, registration is CLOSED unless this is true. While it is true,
# ANYONE who can reach the API can create an account: enable it only on a trusted network and only for as long as needed. It is read
# at startup, so changing it needs an API restart. (There are no invitations yet.)
AUTH_ALLOW_REGISTRATION=false
# AUTH_ALLOW_INSECURE_ORIGIN=false
# A session ends after this long without use (minutes), and this long after sign-in regardless of use (hours).
SESSION_IDLE_TTL_MINUTES=1440
SESSION_ABSOLUTE_TTL_HOURS=336
# How many reverse proxies sit in front of the API (0 on the host; Compose sets 1 for the web container's nginx). Rate limiting uses
# the client address, which is only trustworthy when this matches reality.
# TRUST_PROXY_HOPS=0

# --- PostgreSQL (Docker Compose creates the database from these values) ---
# POSTGRES_USER is the superuser. It exists for bootstrap only: the `db-roles` service uses it to provision the two roles below, and
# test tooling uses it to create throwaway databases. The API and the migration process never connect as the superuser.
POSTGRES_USER=agentos
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=agentos
POSTGRES_PORT=5432
# Passwords of the two roles Compose provisions (infrastructure/postgres/roles.sql). The role names are fixed:
#   agentos_migrate   owns the schemas and tables; runs the migrations (`pnpm db:deploy`, the `migrate` service)
#   agentos_api       what the API connects as: not a superuser, owns nothing, gets only the privileges each migration grants
POSTGRES_MIGRATE_PASSWORD=change-me-migrate
POSTGRES_APP_PASSWORD=change-me-app
# The API connects with DATABASE_URL (role agentos_api). Prisma CLI commands (db:*) use DATABASE_MIGRATE_URL (role agentos_migrate).
# DATABASE_ADMIN_URL (the superuser) is read only by test tooling that creates throwaway databases; no application reads it.
# Each must match the values above. Use 127.0.0.1 (not "localhost") to avoid IPv6 resolution surprises.
DATABASE_URL=postgresql://agentos_api:change-me-app@127.0.0.1:5432/agentos?schema=public
DATABASE_MIGRATE_URL=postgresql://agentos_migrate:change-me-migrate@127.0.0.1:5432/agentos?schema=public
DATABASE_ADMIN_URL=postgresql://agentos:change-me-postgres@127.0.0.1:5432/agentos?schema=public

# --- Redis ---
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379
REDIS_URL=redis://:change-me-redis@127.0.0.1:6379

# --- Worker (apps/worker; reads REDIS_URL, NODE_ENV and LOG_LEVEL from above) ---
# Redis key namespace for queues. Producers (the API) and workers must use the same value.
QUEUE_PREFIX=agentos
# Distinct name per deployed worker; shown in logs and in Redis.
WORKER_NAME=worker
# Comma-separated queues this process consumes. Known queues: system
WORKER_QUEUES=system
# Jobs processed in parallel per queue (1-100).
WORKER_CONCURRENCY=5
# A handler running longer than this gets its AbortSignal aborted; the attempt is retried once the handler has ended.
WORKER_JOB_TIMEOUT_MS=60000
# A handler that still ignores the aborted signal after this long makes the worker restart (exit 1). Nothing else can stop it.
WORKER_ABORT_GRACE_MS=10000
# On SIGTERM/SIGINT: how long to wait for running jobs before abandoning them (they are redelivered). Keep it below the
# orchestrator's kill timeout (Docker/Kubernetes default: 10 s / 30 s).
WORKER_SHUTDOWN_GRACE_MS=30000
# Give up starting (exit code 1) if Redis is not usable within this time.
WORKER_STARTUP_TIMEOUT_MS=30000
# A crashed worker's jobs are redelivered after about this long.
WORKER_LOCK_DURATION_MS=30000
# Heartbeat file read by `apps/worker/dist/healthcheck.js` (Docker HEALTHCHECK). Set by Compose; leave unset on the host.
# WORKER_HEALTH_FILE=/tmp/worker-health.json
