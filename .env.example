# Copy to .env for local development: cp .env.example .env
NODE_ENV=development
LOG_LEVEL=info

# Infrastructure (docker compose reads POSTGRES_* / *_PORT; apps read DATABASE_URL / REDIS_URL)
POSTGRES_USER=agentos
POSTGRES_PASSWORD=agentos
POSTGRES_DB=agentos
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://agentos:agentos@localhost:5432/agentos?schema=public
REDIS_URL=redis://localhost:6379

# API
API_HOST=0.0.0.0
API_PORT=3000
CORS_ORIGINS=http://localhost:5173

# Worker
WORKER_CONCURRENCY=5
