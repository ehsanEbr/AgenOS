# Local development configuration. Do NOT put real or shared credentials in this file.
#
#   pnpm setup:env      creates .env from this file with freshly generated random passwords
#
# .env is git-ignored. Docker Compose, the API and the Prisma CLI all read it.

NODE_ENV=development
LOG_LEVEL=info

# --- API ---
API_HOST=127.0.0.1
API_PORT=3000
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL (Docker Compose creates the database from these values) ---
POSTGRES_USER=agentos
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=agentos
POSTGRES_PORT=5432
# Must match the four values above. Use 127.0.0.1 (not "localhost") to avoid IPv6 resolution surprises.
DATABASE_URL=postgresql://agentos:change-me-postgres@127.0.0.1:5432/agentos?schema=public

# --- Redis ---
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379
REDIS_URL=redis://:change-me-redis@127.0.0.1:6379

# --- Worker (apps/worker; reads REDIS_URL, NODE_ENV and LOG_LEVEL from above) ---
# Redis key namespace for queues. Producers (the API) and workers must use the same value.
QUEUE_PREFIX=agentos
# Distinct name per deployed worker; shown in logs and in Redis.
WORKER_NAME=worker
# Comma-separated queues this process consumes. Known queues: system
WORKER_QUEUES=system
# Jobs processed in parallel per queue (1-100).
WORKER_CONCURRENCY=5
# A handler running longer than this gets its AbortSignal aborted; the attempt is retried once the handler has ended.
WORKER_JOB_TIMEOUT_MS=60000
# A handler that still ignores the aborted signal after this long makes the worker restart (exit 1). Nothing else can stop it.
WORKER_ABORT_GRACE_MS=10000
# On SIGTERM/SIGINT: how long to wait for running jobs before abandoning them (they are redelivered). Keep it below the
# orchestrator's kill timeout (Docker/Kubernetes default: 10 s / 30 s).
WORKER_SHUTDOWN_GRACE_MS=30000
# Give up starting (exit code 1) if Redis is not usable within this time.
WORKER_STARTUP_TIMEOUT_MS=30000
# A crashed worker's jobs are redelivered after about this long.
WORKER_LOCK_DURATION_MS=30000
